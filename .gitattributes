# ─── Normalização de line endings ───
# Estratégia: armazenar SEMPRE LF no objeto Git (padrão Unix, portável),
# deixando o working copy livre (Windows pode usar CRLF, sem warnings).
# Atributos por extensão vencem o core.autocrlf global.
#
# Silencia o warning recorrente "CRLF will be replaced by LF" do Git for Windows.

# Default: detecta texto, normaliza para LF no repo
* text=auto eol=lf

# ─── Texto explícito (LF no objeto Git) ───
*.md         text eol=lf
*.yaml       text eol=lf
*.yml        text eol=lf
*.html       text eol=lf
*.htm        text eol=lf
*.xml        text eol=lf
*.json       text eol=lf
*.txt        text eol=lf
*.csv        text eol=lf
*.py         text eol=lf
*.sh         text eol=lf
*.gitignore  text eol=lf
*.gitattributes text eol=lf

# ─── Binários — NUNCA normalizar (evita corrupção silenciosa) ───
*.pdf        binary
*.png        binary
*.jpg        binary
*.jpeg       binary
*.gif        binary
*.zip        binary
*.tar.gz     binary
*.docx       binary
*.xlsx       binary
*.pptx       binary
*.db         binary
*.sqlite     binary

# ─── Caso especial: arquivos do Planalto vêm com encoding mixed ───
# Mantemos texto, mas line endings da fonte podem ser CRLF — git normaliza no commit.
raw/A-normativas/*.html  text eol=lf