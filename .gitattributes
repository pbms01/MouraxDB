* text=auto eol=lf
*.gitkeep binary

# Git LFS — binários pesados em raw/ (landing zone)
# Instalar no Windows: git lfs install (uma vez por máquina)
# Padrões aplicam-se recursivamente a raw/ em qualquer tipo (A-H).
raw/**/*.pdf  filter=lfs diff=lfs merge=lfs -text
raw/**/*.epub filter=lfs diff=lfs merge=lfs -text

# Formatos estruturados em raw/ permanecem em texto (diffável, blame-compatível)
raw/**/*.html text eol=lf
raw/**/*.txt  text eol=lf
raw/**/*.md   text eol=lf
raw/**/*.json text eol=lf
raw/**/*.xml  text eol=lf
raw/**/*.yaml text eol=lf
